<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_demo_data" model="ir.cron">
        <field name="name">CAP - Load Demo Data</field>
        <field name="model_id" ref="model_demo_data"/> <!-- Reference to the model -->
        <field name="state">code</field>
        <field name="code">
env['demo.data'].search([('is_active', '=', True)]).process_action_queue()
        </field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">5</field>
    </record>
</odoo>
