<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="demo_data_form" model="ir.actions.act_window">
        <field name="name">Demo Data</field>
        <field name="res_model">demo.data</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="api_key_form" model="ir.actions.act_window">
        <field name="name">Api Key</field>
        <field name="res_model">api.key</field>
        <field name="view_mode">list</field>
    </record>
    <record id="module_load_list" model="ir.actions.act_window">
        <field name="name">Modules to load</field>
        <field name="res_model">module.load.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>